# Streamlit Community Cloud Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your API keys.
# NEVER commit secrets.toml to git!

# Google Gemini API (primary provider)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# DeepSeek API (optional fallback)
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY = "your-deepseek-api-key-here"

# Qwen/DashScope API (optional)
# Get a key at https://dashscope.console.aliyun.com/
QWEN_API_KEY = "your-qwen-api-key-here"

# Ollama (local development only - no key needed)
# OLLAMA_BASE_URL = "http://localhost:11434/v1"
# OLLAMA_MODEL = "llama3:8b"